# Leave DATABASE_URL unset to run against the local SQLite database
# at data/smarthostel.db (the default — no setup required).
#
# Set it to a Supabase/Postgres connection string to run against
# Supabase instead. Get this from your Supabase project: Project
# Settings -> Database -> Connection string (URI). Apply
# supabase/schema.sql to that project first (SQL editor or
# `supabase db push`) — the app does not create tables in Postgres.
#
# DATABASE_URL=postgresql://postgres:[password]@[host]:[port]/postgres

# Signs/verifies the access_token POST /login issues (src/services/
# auth_service.py) — every other non-public endpoint requires one via
# src/api/deps.py. Falls back to an insecure dev-only value (with a
# console warning) if unset; set a real one before deploying anywhere
# real. Generate one with: openssl rand -base64 32
JWT_SECRET=

# Encrypts every stored face template (AES-256-GCM) — see
# src/services/template_store.py. The server refuses to start without it.
# Generate with: python -m src.encrypt_templates generate-key
# Back the key up SEPARATELY from the data: if it is lost every template
# is unrecoverable and people must re-enrol. Several comma-separated keys
# are allowed (first encrypts, all decrypt) for rotation.
# After setting it, encrypt existing templates once with:
#   python -m src.encrypt_templates migrate
TEMPLATE_ENCRYPTION_KEYS=
# Local throwaway development ONLY: store templates in plain text.
# TEMPLATE_ENCRYPTION_DISABLED=1
# Optional strict mode: refuse to read any template that is not encrypted
# (turn on once `migrate` has run).
# TEMPLATE_REQUIRE_ENCRYPTED=1
