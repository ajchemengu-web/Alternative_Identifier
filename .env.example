# Leave DATABASE_URL unset to run against the local SQLite database
# at data/smarthostel.db (the default — no setup required).
#
# Set it to a Supabase/Postgres connection string to run against
# Supabase instead. Get this from your Supabase project: Project
# Settings -> Database -> Connection string (URI). Apply
# supabase/schema.sql to that project first (SQL editor or
# `supabase db push`) — the app does not create tables in Postgres.
#
# DATABASE_URL=postgresql://postgres:[password]@[host]:[port]/postgres
